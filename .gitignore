# Build output
/bin/
/dist/
/switchnet-*
# Binaries from a bare `go build ./cmd/<name>`, which drops them in the repo root.
/dauth
/aauth
/baas
/stubs
/natcheck
/switchnetctl

# Generated secrets and certificates — never commit these.
/certs/
/switch/ca/
/config/config.yaml
*.pem
*.key
*.crt
*.csr
*.srl

# Local dev state — bind-mounted into containers and read by natively-run
# services (see docker-compose.yml and CLAUDE.md's dev-mode note). Same
# signing keys as the `keys` volume used to hold; never commit these.
/dev/

# Generated Switch-side files
/switch/hosts.txt
/deploy/nginx.generated.conf
/deploy/switchnet.dnsmasq.conf
/deploy/switchnet.unbound.conf

# Local data
/data/
*.log

# Operator-specific runtime config.
/.env

# Raw capture output from scripts/capture-baas.py. Contains friend nicknames
# and user IDs; commit only the per-endpoint docs under docs/CAPTURES/*.md.
/docs/CAPTURES/raw/

# Python (scripts/capture-baas.py)
__pycache__/
*.pyc

# Editor / OS
.DS_Store
.idea/
.vscode/

# Upstream NPLN protobuf definitions, fetched by scripts/fetch-proto.sh.
# Only the generated Go in proto/ is tracked.
.proto-upstream/
