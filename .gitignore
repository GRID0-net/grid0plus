# Build output
/bin/
/dist/
/switchnet-*
# Binaries from a bare `go build ./cmd/<name>`, which drops them in the repo root.
/dauth
/aauth
/baas
/stubs
/natcheck
/switchnetctl

# Generated secrets and certificates — never commit these.
/certs/
/switch/ca/
/config/config.yaml
*.pem
*.key
*.crt
*.csr
*.srl

# Generated Switch-side files
/switch/hosts.txt
/deploy/nginx.generated.conf
/deploy/switchnet.dnsmasq.conf
/deploy/switchnet.unbound.conf

# Local data
/data/
*.log

# Operator-specific runtime config.
/.env

# Raw capture output from scripts/capture-baas.py. Contains friend nicknames
# and user IDs, so it is never committed.
/captures/

# Python (scripts/capture-baas.py)
__pycache__/
*.pyc

# Editor / OS
.DS_Store
.idea/
.vscode/

# Claude Code local tooling state (session worktrees, etc.) -- never repo content.
.claude/

# Upstream NPLN protobuf definitions, fetched by scripts/fetch-proto.sh.
# Only the generated Go in proto/ is tracked.
.proto-upstream/

# Scratchpad backups (raw packet captures, crash-analysis scratch files).
# Never repo content.
docs/scratchpad backups/

# Service binaries built into the repo root.
#
# `go build ./cmd/npln` with no -o writes ./npln, which is easy to do by accident
# and produces a ~25MB blob that is permanent once committed. `make build` puts
# them in bin/ (ignored above); these entries catch the other way.
/dauth
/aauth
/baas
/dns
/stubs
/natcheck
/npln
/switchnetctl

# Local dev keys and SD-card drops never belong in git.
dev/keys/
dev/sd-drop-*
