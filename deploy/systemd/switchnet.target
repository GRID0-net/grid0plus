[Unit]
Description=SwitchNet (all Go services)
Wants=switchnet-dauth.service switchnet-aauth.service \
      switchnet-baas.service switchnet-scsi.service switchnet-stubs.service switchnet-natcheck.service \
      switchnet-npln.service switchnet-nex.service switchnet-dashboard.service switchnet-toolbox.service

[Install]
