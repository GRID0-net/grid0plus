[Unit]
Description=SwitchNet nex (Splatoon 2)
PartOf=switchnet.target
After=network-online.target docker.service
Wants=network-online.target
# See the StartLimitIntervalSec comment on switchnet-baas.service -- nex
# has the same Postgres-on-startup dependency.
StartLimitIntervalSec=0

[Service]
Type=simple
User=switchnet
Group=switchnet
WorkingDirectory=/opt/switchnet
ExecStart=/opt/switchnet/bin/nex -config /opt/switchnet/config/config.yaml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=switchnet.target
