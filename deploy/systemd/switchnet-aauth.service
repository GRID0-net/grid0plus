[Unit]
Description=SwitchNet aauth
PartOf=switchnet.target
After=network-online.target switchnet-dauth.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=switchnet
Group=switchnet
WorkingDirectory=/opt/switchnet
ExecStart=/opt/switchnet/bin/aauth -config /opt/switchnet/config/config.yaml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=switchnet.target
