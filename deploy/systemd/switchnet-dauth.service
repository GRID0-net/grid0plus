[Unit]
Description=SwitchNet dauth
PartOf=switchnet.target
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=switchnet
Group=switchnet
WorkingDirectory=/opt/switchnet
ExecStart=/opt/switchnet/bin/dauth -config /opt/switchnet/config/config.yaml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=switchnet.target
