[Unit]
Description=GRID0+ natcheck
PartOf=switchnet.target
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=switchnet
Group=switchnet
WorkingDirectory=/opt/switchnet
ExecStart=/opt/switchnet/bin/natcheck -config /opt/switchnet/config/config.yaml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=switchnet.target
