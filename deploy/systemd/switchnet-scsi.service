[Unit]
Description=SwitchNet scsi (OLSC cloud save)
PartOf=switchnet.target
After=network-online.target docker.service switchnet-baas.service
Wants=network-online.target
# See switchnet-baas.service's own comment for why this is uncapped: scsi
# exits immediately if Postgres is not reachable yet (see cmd/scsi/main.go),
# and a fresh boot gives no guarantee it is ready before this unit starts.
StartLimitIntervalSec=0

[Service]
Type=simple
User=switchnet
Group=switchnet
WorkingDirectory=/opt/switchnet
ExecStart=/opt/switchnet/bin/scsi -config /opt/switchnet/config/config.yaml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=switchnet.target
