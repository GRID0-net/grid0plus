[Unit]
Description=SwitchNet dns
PartOf=switchnet.target
After=network-online.target
Wants=network-online.target
# Unlimited retries: see the StartLimitIntervalSec comment on
# switchnet-baas.service for why this matters even though dns itself has no
# database dependency -- it is set uniformly across every unit in this
# directory rather than only where it is currently load-bearing.
StartLimitIntervalSec=0

[Service]
Type=simple
User=switchnet
Group=switchnet
WorkingDirectory=/opt/switchnet
ExecStart=/opt/switchnet/bin/dns -config /opt/switchnet/config/config.yaml
Restart=on-failure
RestartSec=2

# A console cannot be told to use a port other than 53, and binding it needs
# a privilege plain User= does not have. AmbientCapabilities is the native
# equivalent of docker-compose.yml's `cap_add: NET_BIND_SERVICE` on this
# service -- and unlike that Dockerfile's `setcap` step, it needs no
# reapplying after every rebuild, since it is a unit property, not a file
# attribute go build would drop.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=switchnet.target
