# Adapt hostname and certificate locations before including this configuration.
# This is an independent browser-facing hostname, never a Nintendo SNI route.
server {
    listen 443 ssl;
    server_name inklink.example.com;
    ssl_certificate /etc/letsencrypt/live/inklink.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/inklink.example.com/privkey.pem;
    client_max_body_size 8k;
    location / {
        proxy_pass http://127.0.0.1:8097;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
